<h1 style="margin:0 0 16px; font-size:22px; line-height:1.3; font-weight:600; color:#111827;">
  <%= pluralize(@violations.size + @hidden_count, "new violation") %> on <%= @website.domain %>
</h1>
<p style="margin:0 0 20px; font-size:15px; line-height:1.6; color:#374151;">
  Browsers started reporting something your Content Security Policy has not blocked before.
  That is usually a new script or resource after a deploy, and sometimes injected content.
</p>
<%= render "violation_rows", rows: @violations.map { [_1.directive, _1.blocked_source, _1.reports_count] } %>
<% if @hidden_count.positive? %>
  <p style="margin:8px 0 0; font-size:13px; line-height:1.6; color:#6b7280;">
    and <%= @hidden_count %> more in the dashboard.
  </p>
<% end %>

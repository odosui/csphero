<h1 style="margin:0 0 16px; font-size:22px; line-height:1.3; font-weight:600; color:#111827;">
  <%= @website.domain %>: the last 7 days
</h1>
<p style="margin:0 0 24px; font-size:15px; line-height:1.6; color:#374151;">
  <strong style="color:#111827;"><%= pluralize(number_with_delimiter(@digest.reports_count), "report") %></strong>,
  compared to <%= number_with_delimiter(@digest.previous_reports_count) %> the week before.
</p>

<h2 style="margin:0 0 8px; font-size:15px; font-weight:600; color:#111827;">New this week</h2>
<% if @digest.new_violations.any? %>
  <%= render "violation_rows", rows: @digest.new_violations.first(AlertMailer::LIST_SIZE).map { [_1.directive, _1.blocked_source, _1.reports_count] } %>
<% else %>
  <p style="margin:0 0 8px; font-size:14px; line-height:1.6; color:#6b7280;">No new violations. Nothing changed in what your policy blocks.</p>
<% end %>

<h2 style="margin:24px 0 8px; font-size:15px; font-weight:600; color:#111827;">Most reported</h2>
<%= render "violation_rows", rows: @digest.top_violations.map { [_1.directive, _1.blocked_source, _1.count] } %>

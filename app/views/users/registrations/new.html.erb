<%= render layout: "users/shared/auth_card", locals: { title: "Create an account" } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= render "users/registrations/bot_traps" %>
    <%= render "users/shared/flash" %>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        <p class="field-hint"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="form-group checkbox">
      <%= f.check_box :accept_terms, required: true %>
      <%= f.label :accept_terms do %>
        I accept the <%= link_to "Terms of Use", terms_path, target: "_blank" %>
      <% end %>
    </div>

    <div class="actions">
      <%= f.submit "Sign up" %>
    </div>
  <% end %>
<% end %>
